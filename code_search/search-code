#!/bin/bash
# Semantic code search across all indexed repositories (e5 index via OVMS).
# Usage: search-code "your query" [--repo name] [--limit N] [--language js] [--type function]

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

if [[ -f "$SCRIPT_DIR/.env" ]]; then
    export $(grep -v '^#' "$SCRIPT_DIR/.env" | xargs)
fi

cd "$SCRIPT_DIR"
source .venv/bin/activate 2>/dev/null || true

if [[ -z "$CODE_SEARCH_DB_URL" ]]; then
    echo "Error: set CODE_SEARCH_DB_URL in $SCRIPT_DIR/.env (see .env.example)"
    exit 1
fi

python3 search.py "$@" --db-url "$CODE_SEARCH_DB_URL"
